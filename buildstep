#!/bin/bash
set -e
NAME="$1"
TAG="$2"

# Place the app inside the container
ID=$(cat | docker run -i -a stdin deis/buildstep /bin/bash -c "mkdir -p /app && tar -xC /app")
test $(docker wait $ID) -eq 0
docker commit $ID $NAME $TAG > /dev/null

# Run the builder script and attach to view output
ID=$(docker run -d $NAME:$TAG /build/builder)
docker attach $ID
test $(docker wait $ID) -eq 0
docker commit $ID $NAME $TAG > /dev/null
