#!/bin/bash
set -eo pipefail
source $(dirname $0)/config/paths.sh

mkdir -p $app_dir
mkdir -p $env_dir
mkdir -p $cache_root
mkdir -p $buildpack_root
mkdir -p $build_root/.profile.d

user_id=$((RANDOM+1000))
user_name="u${user_id}"

# Create a random user
/usr/sbin/addgroup --quiet --gid $user_id $user_name
/usr/sbin/adduser --shell /bin/bash \
                  --disabled-password \
                  --force-badname \
                  --no-create-home \
                  --uid $user_id \
                  --gid $user_id \
                  --gecos '' \
                  --quiet \
                  --home $app_dir \
                  $user_name

# Grant the user access to all required paths before
# running the compile phase as non-privileged user.
chgrp $user_name /dev
chown $user_name:$user_name /dev/shm /tmp /var/tmp
chown -R $user_name:$user_name  $app_dir \
                                $env_dir \
                                $cache_root \
                                $buildpack_root \
                                $build_root

# Compile the slug
/usr/bin/setuidgid $user_name /build/compile.sh

# Populate the service directory
pushd $build_root >/dev/null
[[ ! -f Procfile ]] && ruby -e "require 'yaml';(YAML.load_file('$build_root/.release')['default_process_types'] || {}).tap { |p| File.open('Procfile', 'w') { |f| f.puts p.to_yaml } }"
/build/populate-service-dir .service Procfile
popd >/dev/null

## Generate start commands
cat >/exec <<EOF
#!/bin/bash
export HOME=$app_dir
chown -R $user_name:$user_name $app_dir
cd $app_dir

for file in .profile.d/*.sh; do
  source \$file
done
hash -r

exec 2>&1
exec setuidgid $user_name \$@
EOF

cat >/start <<EOF
#!/bin/bash
export HOME=$app_dir
chown -R $user_name:$user_name $app_dir
cd $app_dir

for file in .profile.d/*.sh; do
  source \$file
done
hash -r

exec 2>&1
exec setuidgid $user_name runsv ".service/\$1"
EOF

chmod +x /start /exec
rm -rf $app_dir
mv $build_root $app_dir

# Clean up
rm -rf /build/
rm -rf /tmp/*
